# ============================================================
# Hugging Face API Token 配置
# ============================================================
# 1. 访问 https://huggingface.co/settings/tokens
# 2. 创建新的 Access Token（选择 fine-grained 类型）
# 3. 勾选 "Make calls to Inference Providers" 权限
# 4. 复制 Token 并填入下方
#
# 注意：请勿将 .env 文件提交到版本控制系统

HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxx
