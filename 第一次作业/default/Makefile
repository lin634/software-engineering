# ==================== 变量定义 ====================
# 编译器
CC = gcc
# 编译选项
# -Wall  开启所有警告
# -g     生成调试信息，便于用 gdb 调试
# -O2    优化级别（可选，调试时可去掉）
CFLAGS = -Wall -g
# 目标可执行文件名
TARGET = signal_demo
# 源文件
SRC = 1.c

# ==================== 默认目标 ====================
# make 或 make all 时执行
all: $(TARGET)

# ==================== 链接规则 ====================
# 由源文件生成可执行文件
$(TARGET): $(SRC)
	$(CC) $(CFLAGS) -o $(TARGET) $(SRC)

# ==================== 辅助目标 ====================
# 运行程序
run: $(TARGET)
	./$(TARGET)

# 清理生成的文件
clean:
	rm -f $(TARGET)

# ==================== 伪目标声明 ====================
# 声明这些目标不是文件名，避免与同名文件冲突
.PHONY: all run clean
